---
import { owner, demos, cases } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const [firstName, ...rest] = owner.name.split(' ');
---
<!-- The ribbon canvas sits behind the whole page; the SVG is the no-WebGL fallback. -->
<div class="atmosphere" aria-hidden="true">
  <svg class="atmosphere-fallback" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice"><g fill="none" stroke="currentColor"><path d="M230 440C280 100 1020 30 1080 380S540 830 470 560S1090 80 1110 400"/><path d="M225 448C290 110 1010 45 1065 380S540 810 480 550S1070 100 1090 405"/><path d="M220 456C300 120 1000 60 1050 380S540 790 490 540S1050 120 1070 410"/></g></svg>
  <canvas id="ribbons"></canvas>
</div>

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-role">{owner.roleLine}</p>
      <h1 id="hero-title" class="hero-name">
        <span class="name-line"><span>{firstName}</span></span>{' '}
        <span class="name-line name-line--accent"><span>{rest.join(' ')}</span></span>
      </h1>
      <p class="hero-promise">{owner.promise}</p>
      <p class="hero-intro">{owner.intro}</p>
      <div class="hero-actions">
        <a class="btn btn--primary" href="#work">See the work <b aria-hidden="true">&darr;</b></a>
        <a class="btn btn--ghost" href={owner.upworkUrl} target="_blank" rel="noopener">Hire me on Upwork <b aria-hidden="true">&nearr;</b></a>
      </div>
    </div>

    <figure class="portrait">
      {owner.photo
        ? <img src={`${base}${owner.photo}`} alt={owner.name} width="480" height="600" fetchpriority="high">
        : <div class="portrait-placeholder" role="img" aria-label={`${owner.name} monogram`}><span>{owner.initials}</span></div>}
      <figcaption>
        <span class="status-dot" aria-hidden="true"></span>
        Web · .NET · Cloud
      </figcaption>
    </figure>
  </div>

  <dl class="hero-facts">
    <div><dt>Shipped product</dt><dd>{cases[0].title}</dd></div>
    <div><dt>Live concept demos</dt><dd>{demos.length}</dd></div>
    <div><dt>Service areas</dt><dd>Web · .NET · APIs · DevOps</dd></div>
  </dl>
</section>

<style>
  .atmosphere {
    position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden; color: var(--lime);
    background:
      radial-gradient(ellipse at 78% 32%, #d5f59124, transparent 62%),
      radial-gradient(ellipse at 25% 92%, #78cfac1c, transparent 60%),
      var(--bg);
  }
  .atmosphere::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, #00000052, transparent 62%), radial-gradient(ellipse at center, transparent 35%, #00000047); }
  .atmosphere-fallback, #ribbons { position: absolute; inset: 0; width: 100%; height: 100%; }
  .atmosphere-fallback { opacity: .45; transition: opacity .6s; }
  :global(.atmosphere.canvas-ready) .atmosphere-fallback { opacity: 0; }

  .hero { position: relative; z-index: 1; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; padding: 120px var(--pad) 32px; }
  .hero-inner { width: 100%; max-width: var(--max); margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: clamp(32px, 6vw, 96px); }
  .hero-role { font-size: var(--step--1); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: #bdc7b5; margin-bottom: 26px; }
  .hero-name { font-size: var(--step-4); line-height: .9; letter-spacing: -.075em; font-weight: 500; }
  .name-line { display: block; overflow: hidden; padding-bottom: .08em; margin-bottom: -.08em; }
  .name-line > span { display: block; }
  .name-line--accent { color: var(--lime); }
  .hero-promise { font: 400 var(--step-2)/1.2 var(--font-serif); letter-spacing: -.03em; margin-top: clamp(28px, 4vw, 48px); text-shadow: 0 1px 14px #050808; }
  .hero-intro { max-width: 470px; margin-top: 14px; color: #c9d0c4; text-shadow: 0 1px 14px #050808, 0 0 2px #050808; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .portrait { position: relative; width: clamp(220px, 24vw, 340px); aspect-ratio: 4 / 5; margin: 0; }
  .portrait img, .portrait-placeholder { width: 100%; height: 100%; object-fit: cover; border-radius: 28px; border: 1px solid var(--line-strong); }
  .portrait-placeholder {
    display: grid; place-items: center;
    background: radial-gradient(circle at 30% 20%, #d5f59133, transparent 55%), linear-gradient(160deg, #18211a, #0b100d);
  }
  .portrait-placeholder span { font-size: clamp(64px, 8vw, 120px); font-weight: 700; letter-spacing: -.08em; color: var(--lime); }
  .portrait figcaption {
    position: absolute; left: 16px; bottom: 16px; display: flex; align-items: center; gap: 10px;
    padding: 8px 14px; border-radius: 99px; background: #0b100de0; border: 1px solid var(--line);
    font-size: 12px; font-weight: 600; letter-spacing: .06em; -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px);
  }
  .status-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--lime); box-shadow: 0 0 12px var(--lime); }

  .hero-facts { width: 100%; max-width: var(--max); margin: clamp(48px, 7vw, 88px) auto 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); }
  .hero-facts div { padding: 18px 24px 0 0; }
  .hero-facts div + div { padding-left: 24px; border-left: 1px solid var(--line); }
  .hero-facts dt { font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--faint); }
  .hero-facts dd { margin-top: 4px; font-size: var(--step-1); font-weight: 600; letter-spacing: -.02em; }

  @media (prefers-reduced-motion: no-preference) {
    .name-line > span { animation: name-in 1.2s var(--ease-out) both; }
    .name-line--accent > span { animation-delay: .12s; }
    .portrait { animation: fade-in 1.2s .25s var(--ease-out) both; }
    @keyframes name-in { from { translate: 0 110%; } }
    @keyframes fade-in { from { opacity: 0; scale: .96; } }
  }

  @media (max-width: 860px) {
    .hero { padding-top: 104px; }
    .hero-inner { grid-template-columns: 1fr; }
    .portrait { order: -1; width: 112px; aspect-ratio: 1; }
    .portrait img, .portrait-placeholder { border-radius: 50%; }
    .portrait-placeholder span { font-size: 40px; }
    .portrait figcaption { display: none; }
    .hero-facts { grid-template-columns: 1fr; }
    .hero-facts div, .hero-facts div + div { padding: 14px 0; border-left: 0; border-bottom: 1px solid var(--line); }
  }
  @media (max-width: 520px) {
    .hero-actions .btn { flex: 1 1 100%; }
  }
</style>
