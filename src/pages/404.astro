---
import Base from '../layouts/Base.astro';
import { owner } from '../data/site.js';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<Base title={`Page not found — ${owner.name}`} description="This page does not exist." noindex>
  <main class="not-found">
    <div>
      <div class="mark" aria-hidden="true">✳</div>
      <span class="eyebrow">Error 404 · Page not found</span>
      <h1>This page wandered off.</h1>
      <p>The link may be old or mistyped. The portfolio and all eleven live demos are one click away.</p>
      <a class="btn btn--primary" href={base}>Back to the portfolio <b aria-hidden="true">&rarr;</b></a>
    </div>
  </main>
</Base>

<style>
  .not-found { min-height: 100svh; display: grid; place-items: center; padding: 32px var(--pad); background: radial-gradient(ellipse at 75% 30%, #d5f59124, transparent 60%), var(--bg); }
  .not-found > div { max-width: 640px; }
  .mark { font-size: 72px; line-height: 1; color: var(--lime); margin-bottom: 24px; }
  h1 { font-size: clamp(2.8rem, 2rem + 4vw, 5.5rem); margin-bottom: 20px; }
  p { color: var(--muted); margin-bottom: 32px; }
</style>
